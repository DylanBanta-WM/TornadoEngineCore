#!/usr/bin/env bash
# Start and use the harness: bin/harness up | connect <token> | claude | shell | down
set -euo pipefail
cd "$(dirname "$0")/../harness"

export HARNESS_UID="${HARNESS_UID:-$(id -u)}" HARNESS_GID="${HARNESS_GID:-$(id -g)}"

link_network() {
  docker network inspect tornado-link >/dev/null 2>&1 || docker network create --internal tornado-link >/dev/null
}

case "${1:-}" in
  up)
    link_network
    docker compose up -d --build ;;
  connect)
    [ -n "${2:-}" ] || { echo "usage: bin/harness connect <token>" >&2; exit 2; }
    touch .env
    grep -v '^HARNESS_TOKEN=' .env > .env.new || true
    echo "HARNESS_TOKEN=$2" >> .env.new
    mv .env.new .env
    chmod 600 .env
    link_network
    docker compose up -d --build ;;
  claude) shift; docker compose exec -it harness harness-claude "$@" ;;
  shell)  docker compose exec -it harness bash ;;
  down)   docker compose down ;;
  *)      echo "usage: bin/harness up | connect <token> | claude | shell | down" >&2; exit 2 ;;
esac
