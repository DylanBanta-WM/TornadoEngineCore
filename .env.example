# A name for this copy. Two copies on one server need different names and WEB_PORTs.
COMPOSE_PROJECT_NAME=tornado

APP_NAME="Tornado Engine"
APP_ENV=production
APP_DEBUG=false
# Generate with: echo "base64:$(openssl rand -base64 32)"
APP_KEY=

DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=tornado
DB_USERNAME=tornado
DB_PASSWORD=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Address and port the website listens on. 0.0.0.0 is every address on this server.
WEB_BIND=0.0.0.0
WEB_PORT=8090

# Your user and group IDs on this server (id -u, id -g), so files stay yours.
HOST_UID=1000
HOST_GID=1000

# The harness's internet access: open, logged or strict.
HARNESS_NETWORK=open
